{
  "$schema": "../schema/experiment.schema.json",
  "schema_version": 1,
  "experiment_id": "donchian-breakout-single",
  "description": "One explicit Donchian channel breakout configuration.",
  "data": {
    "path": "data/market/sp500_1950_2018.csv",
    "asset": "SP500",
    "start_date": "2000-01-01",
    "end_date": "2010-12-31"
  },
  "execution": {
    "initial_cash": 10000.0,
    "transaction_cost_rate": 0.001,
    "slippage_rate": 0.0005
  },
  "strategies": [
    {
      "id": "donchian",
      "type": "donchian_channel_breakout",
      "parameters": {
        "entry_period": 55,
        "exit_period": 20
      }
    }
  ],
  "output": {
    "include_trades": true
  }
}
