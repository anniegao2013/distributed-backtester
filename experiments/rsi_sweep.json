{
  "$schema": "../schema/experiment.schema.json",
  "schema_version": 1,
  "experiment_id": "rsi-sweep",
  "description": "RSI mean-reversion sweep with explicit execution costs.",
  "data": {
    "path": "data/market/sp500_1950_2018.csv",
    "asset": "SP500",
    "start_date": "2000-01-01",
    "end_date": "2010-12-31"
  },
  "execution": {
    "initial_cash": 25000.0,
    "transaction_cost_rate": 0.0005,
    "slippage_rate": 0.0002,
    "max_concurrent_jobs": 4
  },
  "strategies": [
    {
      "id": "rsi",
      "type": "rsi_mean_reversion",
      "grid": {
        "rsi_period": [10, 14],
        "oversold_threshold": [25, 30],
        "exit_threshold": [65, 70]
      }
    }
  ]
}
