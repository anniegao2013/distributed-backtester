{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/backtester-experiment-result.schema.json",
  "title": "Distributed Backtester Experiment Result",
  "description": "Response document produced by the backtester for an experiment request.",
  "oneOf": [
    {
      "$ref": "#/$defs/runResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "runResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "experiment_id",
        "data",
        "execution",
        "summary",
        "results"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": ["completed", "partial", "failed"]
        },
        "experiment_id": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "asset",
            "start_date",
            "end_date",
            "trading_days",
            "first_date",
            "last_date"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "asset": {
              "type": "string"
            },
            "start_date": {
              "type": "string"
            },
            "end_date": {
              "type": "string"
            },
            "trading_days": {
              "type": "integer",
              "minimum": 0
            },
            "first_date": {
              "type": "string"
            },
            "last_date": {
              "type": "string"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_cash",
            "transaction_cost_rate",
            "slippage_rate",
            "max_concurrent_jobs"
          ],
          "properties": {
            "initial_cash": {
              "type": "number"
            },
            "transaction_cost_rate": {
              "type": "number"
            },
            "slippage_rate": {
              "type": "number"
            },
            "max_concurrent_jobs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jobs_total",
            "jobs_completed",
            "jobs_failed",
            "wall_seconds",
            "best_job_id",
            "best_sharpe_ratio",
            "best_total_return",
            "performance"
          ],
          "properties": {
            "jobs_total": {
              "type": "integer",
              "minimum": 0
            },
            "jobs_completed": {
              "type": "integer",
              "minimum": 0
            },
            "jobs_failed": {
              "type": "integer",
              "minimum": 0
            },
            "wall_seconds": {
              "type": "number",
              "minimum": 0
            },
            "best_job_id": {
              "type": "string"
            },
            "best_sharpe_ratio": {
              "type": "number"
            },
            "best_total_return": {
              "type": "number"
            },
            "performance": {
              "$ref": "#/$defs/performance"
            }
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jobResult"
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "error"],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": ["invalid", "failed"]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message"],
          "properties": {
            "type": {
              "enum": [
                "json_parse_error",
                "validation_error",
                "runtime_error"
              ]
            },
            "path": {
              "type": "string",
              "description": "JSONPath-like location of the invalid field."
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "jobResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "strategy_id",
        "strategy_type",
        "status",
        "duration_seconds",
        "parameters"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "strategy_id": {
          "type": "string"
        },
        "strategy_type": {
          "type": "string"
        },
        "status": {
          "enum": ["completed", "failed"]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "error": {
          "type": "string"
        },
        "trades": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trade"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_return",
        "sharpe_ratio",
        "max_drawdown",
        "number_of_trades",
        "total_costs"
      ],
      "properties": {
        "total_return": {
          "type": "number"
        },
        "sharpe_ratio": {
          "type": "number"
        },
        "max_drawdown": {
          "type": "number"
        },
        "number_of_trades": {
          "type": "integer",
          "minimum": 0
        },
        "total_costs": {
          "type": "number"
        }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "side",
        "quantity",
        "fill_price",
        "commission",
        "slippage_cost"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "side": {
          "enum": ["buy", "sell"]
        },
        "quantity": {
          "type": "number"
        },
        "fill_price": {
          "type": "number"
        },
        "commission": {
          "type": "number"
        },
        "slippage_cost": {
          "type": "number"
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrent",
        "throughput",
        "mean_latency",
        "median_latency",
        "min_latency",
        "max_latency",
        "p95_latency",
        "total_work_seconds",
        "speedup",
        "cpu_seconds",
        "cpu_utilization",
        "cpu_efficiency"
      ],
      "properties": {
        "max_concurrent": {
          "type": "integer",
          "minimum": 1
        },
        "throughput": {
          "type": "number"
        },
        "mean_latency": {
          "type": "number"
        },
        "median_latency": {
          "type": "number"
        },
        "min_latency": {
          "type": "number"
        },
        "max_latency": {
          "type": "number"
        },
        "p95_latency": {
          "type": "number"
        },
        "total_work_seconds": {
          "type": "number"
        },
        "speedup": {
          "type": "number"
        },
        "cpu_seconds": {
          "type": "number"
        },
        "cpu_utilization": {
          "type": "number"
        },
        "cpu_efficiency": {
          "type": "number"
        }
      }
    }
  }
}
